# Node reads deployment environment variables. For local env files, use
# node --env-file=.env index.js (Node 24).
PORT=3000
NODE_ENV=development
AUTH_MODE=development
MEDIA_MODE=mesh
CLIENT_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Production: all replicas and the media gateway MUST share these values.
# Use a private Render Key Value connection with paid persistence/noeviction.
# REDIS_URL=redis://...
# REDIS_PREFIX=samerow:production:v1
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DATA_ENCRYPTION_KEY=<64 hex characters; retain with encrypted backups>

# Production requires Firebase Admin verification, never development auth.
# AUTH_MODE=firebase
# FIREBASE_PROJECT_ID=<same project as the frontend>
# FIREBASE_SERVICE_ACCOUNT_JSON=<one-line service account JSON; server secret>

# Production requires LiveKit. Cloud provides SFU and TURN; Render hosts Node.
# MEDIA_MODE=livekit
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=<server secret>
# LIVEKIT_API_SECRET=<server secret>

# combined for local development; control and media for independent services.
SERVICE_ROLE=combined
# MEDIA_PUBLIC_URL=https://<actual-media-service>.onrender.com
# Everyone can control playback by default, matching the existing watch party.
CONTROL_POLICY=everyone
MAX_ROOM_SIZE=4
ROOM_TTL_SECONDS=86400
# Shared-IP reconnect bursts (e.g. offices); each authenticated identity is also limited.
MAX_CONNECTIONS_PER_IP_PER_MINUTE=600
# METRICS_TOKEN=<random server secret for GET /metrics>
# ACCESS_LOGS=true

# Public HTTPS libraries are accepted by default. Restrict to your library(s)
# when possible. Private access is an explicit, origin-restricted exception.
# JELLYFIN_ALLOWED_ORIGINS=https://jellyfin.example.com
# JELLYFIN_ALLOW_PRIVATE=false

# Optional measured sustainable bandwidth budgets (Mbps, 0 = unconfigured).
# Same values on every replica; reserve 20% for bitrate peaks and overhead.
# Origin budget applies independently to each Jellyfin origin. Gateway budget
# is shared by ALL movie viewers across rooms and gateway replicas.
JELLYFIN_ORIGIN_BANDWIDTH_MBPS=0
JELLYFIN_GATEWAY_BANDWIDTH_MBPS=0

# Legacy local development persistence only; production uses encrypted Redis.
SAMEROW_DATA_DIR=./.data
JELLYFIN_DIRECT_ENABLED=false
# Optional maximum gateway movie bytes per UTC day. Zero disables the cap.
JELLYFIN_RELAY_DAILY_BYTES=0
