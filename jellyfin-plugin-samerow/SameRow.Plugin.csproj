<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <JellyfinServerPath Condition="'$(JellyfinServerPath)' == ''">$(MSBuildThisFileDirectory)../../jellyfin-sandbox/jellyfin</JellyfinServerPath>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SameRow.Plugin</AssemblyName>
    <RootNamespace>SameRow.Plugin</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.3.0</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Reference assemblies from jellyfin-sandbox for local compilation and tests -->
  <ItemGroup Condition="Exists('$(JellyfinServerPath)/MediaBrowser.Controller.dll')">
    <Reference Include="MediaBrowser.Common">
      <HintPath>$(JellyfinServerPath)/MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>$(JellyfinServerPath)/MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>$(JellyfinServerPath)/MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jellyfin.Api">
      <HintPath>$(JellyfinServerPath)/Jellyfin.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <Target Name="ValidateJellyfinReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(JellyfinServerPath)/MediaBrowser.Controller.dll')" Text="Set JellyfinServerPath to a Jellyfin 12.3 server installation containing MediaBrowser.Controller.dll." />
  </Target>
</Project>
